AUTOMINE_INTERVAL=0
ARKD_SESSION_DURATION=30
# Seconds-mode delays (≥512). Checkpoint must encode ≥1200s for intent-solver
# 0.3.1's SDK floor; BIP68 stores (seconds>>9), so pick multiples of 512.
ARKD_VTXO_TREE_EXPIRY=86400
ARKD_UNILATERAL_EXIT_DELAY=8192
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=8192
ARKD_BOARDING_EXIT_DELAY=16384
ARKD_CHECKPOINT_EXIT_DELAY=4096
